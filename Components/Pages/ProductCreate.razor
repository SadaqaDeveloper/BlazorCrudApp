@page "/products/new"
@using BlazorCrudApp.Data.Models
@inject BlazorCrudApp.Services.ProductService ProductService
@inject BlazorCrudApp.Services.NotificationService Notify
@inject NavigationManager Nav

<h3>Add New Product</h3>

<ProductForm Model="model" FormName="ProductCreateForm" SubmitText="Create" IsBusy="busy" OnValidSubmit="Save" OnCancel="Cancel" />

@code {
    private Product model = new Product();
    private bool busy;

    private async Task Save()
    {
        if (busy) return;
        busy = true;

        try
        {
            await ProductService.CreateAsync(model);
            Notify.Success("Product created successfully.");
            Nav.NavigateTo("/products");
        }
        catch (Exception ex)
        {
            Notify.Error($"Create failed: {ex.Message}");
        }
        finally
        {
            busy = false;
        }
    }

    private Task Cancel()
    {
        Nav.NavigateTo("/products");
        return Task.CompletedTask;
    }
}
